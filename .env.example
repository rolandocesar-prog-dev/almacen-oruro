# Copiar este archivo como .env y ajustar los valores. El .env real nunca se versiona.

# Conexión a la base de desarrollo (la crea docker compose).
DATABASE_URL="postgresql://almacen:almacen@localhost:5432/almacen_oruro"

# Conexión a la base de pruebas. Debe terminar en _test: las pruebas vacían sus tablas.
DATABASE_URL_TEST="postgresql://almacen:almacen@localhost:5432/almacen_oruro_test"

# Zona horaria de Oruro: "hoy" y "mes en curso" se calculan aquí.
TZ="America/La_Paz"

# Contraseña del usuario inicial "admin" que crea la semilla (al menos 8 caracteres).
# Se pide cambiarla en el primer ingreso.
CONTRASENA_INICIAL="cambiar-esta-clave"

# true solo si el sistema se sirve por https. Por http en red local debe ser false.
COOKIE_SEGURA="false"

# Costo de bcrypt para las contraseñas. En producción, 12.
BCRYPT_COSTO="12"

# Clave de la API de Anthropic (F-007). Solo hace falta para GENERAR informes IA nuevos: el pronóstico,
# la evaluación y la consulta e impresión de informes guardados funcionan sin ella y sin internet.
# Sin clave, "Generar informe" avisa que el servicio de redacción no está disponible.
ANTHROPIC_API_KEY=""
